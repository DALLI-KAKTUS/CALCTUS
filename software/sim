#!/bin/sh
# Simülatörü derler ve çalıştırır. Örnekler:
#   ./sim                         pencereyi aç
#   ./sim --scale 2               iki kat büyük
#   ./sim --headless --script software/tests/scripts/keytest.keys
#   ./sim test                    testleri çalıştır
# Simülatör depo kökünde çalışır: sanal microSD kökteki .calctus-sd/ klasörüdür,
# ayarlar .calctus-settings.bin dosyasında. Göreli yollar depo köküne göredir.
set -eu
cd "$(dirname "$0")"

if [ "${1:-}" = "test" ]; then
  exec nix develop .. --command sh -c \
    'cmake -S . -B build -G Ninja >/dev/null && cmake --build build && ctest --test-dir build --output-on-failure'
fi

exec nix develop .. --command sh -c \
  'cmake -S . -B build -G Ninja >/dev/null && cmake --build build >/dev/null && cd .. && exec software/build/calctus-sim "$@"' \
  sim "$@"
